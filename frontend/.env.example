# Variables del front (Vite). Solo las que empiezan con VITE_ llegan al código,
# y terminan dentro del JS que descarga el navegador: no poner secretos acá.
#
# .env.development (versionado) ya trae el valor para desarrollo. Para pisarlo
# en tu máquina, copiá este archivo como .env.local (ignorado por git).

# URL base de la API (sin barra final).
VITE_API_URL=http://localhost:8000
