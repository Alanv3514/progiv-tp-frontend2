# Variables de la API. main.py las carga con load_dotenv() desde un archivo
# .env en esta carpeta: copiá este archivo como .env (ignorado por git).
# Con docker compose también se usa, porque se copia backend/ entero al contenedor.
# Sin .env, la API usa SQLite (database.db), que es lo que necesita el front.

# Motor de base de datos: sqlite (por defecto) o postgres.
DB_ENGINE=sqlite

# Solo si DB_ENGINE=postgres (obligatoria en ese caso). No versionar credenciales reales.
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/basededatos
